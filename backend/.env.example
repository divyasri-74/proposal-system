# Port the API listens on (Render injects PORT automatically)
PORT=4000

# Comma-separated frontend origins allowed by CORS (no trailing slash).
# Leave empty during local development to allow all origins.
ALLOWED_ORIGINS=http://localhost:3000

# Optional: use a system Chrome/Chromium instead of the one Puppeteer downloads
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional: max simultaneous PDF renders (default 3)
# MAX_CONCURRENT_PDFS=3
